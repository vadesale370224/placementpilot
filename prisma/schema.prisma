// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  role         Role     @default(JOB_SEEKER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  profile      Profile?
}

enum Role {
  JOB_SEEKER
  EMPLOYER
  INSTITUTE
  ADMIN
}

enum VerificationLevel {
  SELF_REPORTED
  AI_VERIFIED
  INSTITUTE_VERIFIED
  EMPLOYER_VERIFIED
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String
  phone             String?  @unique
  bio               String?
  avatarUrl         String?
  companyName       String?  // For employer role
  
  // Multilingual & Locality settings
  preferredLanguage String   @default("en") // Selected active UI language (e.g., "en", "hi", "mr")
  languages         Json     // Spoken/supported languages list (JSON Array, e.g. ["en", "hi", "mr"])
  state             String?  // Indian State location (e.g., "Maharashtra", "Tamil Nadu")
  
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  skillPassport     SkillPassport?
  jobListings       JobListing[]
  applications      Application[]
  matchResults      MatchResult[]
  interviewSessions InterviewSession[]
}

model SkillPassport {
  id                String            @id @default(cuid())
  profileId         String            @unique
  profile           Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skills            Json              // Array of skills with proficiency levels & verification status
  readinessScore    Float             @default(0)
  verificationLevel VerificationLevel @default(SELF_REPORTED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model JobListing {
  id                String   @id @default(cuid())
  employerId        String
  employer          Profile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  title             String
  description       String
  requirements      Json     // List of requirements/skills
  requiredLanguages Json?    // Required languages (JSON Array, e.g. ["en", "hi"])
  location          String?
  salary            String?
  status            String   @default("OPEN")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  applications      Application[]
  matchResults      MatchResult[]
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  job         JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobSeekerId String
  jobSeeker   Profile  @relation(fields: [jobSeekerId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  interviewSessions InterviewSession[]
}

model MatchResult {
  id           String   @id @default(cuid())
  jobListingId String
  jobListing   JobListing @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  score        Float
  matchDetails Json?
  createdAt    DateTime @default(now())
}

model InterviewSession {
  id            String   @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  topic         String
  status        String   @default("SCHEDULED")
  scheduledAt   DateTime
  feedback      Json?
  transcript    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
